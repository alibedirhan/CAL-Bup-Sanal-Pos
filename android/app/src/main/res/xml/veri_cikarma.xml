<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulut yedeği ve cihazdan cihaza aktarım hiçbir veriyi almaz.
     Kart kasası yalnız bu telefonda kalır (docs/ANDROID_PLANI.md §4.2). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
