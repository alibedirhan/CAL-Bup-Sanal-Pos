rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function uye() { return request.auth != null && get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.aktif == true; }
    function yonetici() { return uye() && get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.yonetici == true; }
    function erisim(sahip) { return uye() && (request.auth.uid == sahip || yonetici()); }
    function hedefAktif(uid) { return get(/databases/$(database)/documents/kullanicilar/$(uid)).data.aktif == true; }
    function metin(s, min, max) {
      return s is string && s.size() >= min && s.size() <= max && !s.matches('.*[\\x00-\\x1F\\x7F].*');
    }
    function kart(k) {
      return k.keys().hasOnly(['id', 'ad', 'sonDort', 'ay', 'yil', 'cihazKayitId'])
        && k.keys().hasAll(['cihazKayitId'])
        && k.id.matches('^[A-Za-z0-9_-]{1,80}$')
        && k.ad.matches('^[^\\x00-\\x1F\\x7F]{2,60}$')
        && !k.ad.matches('.*[0-9][0-9 -]{10,}[0-9].*')
        && k.sonDort.matches('^[0-9]{4}$')
        && (!('cihazKayitId' in k) || k.cihazKayitId.matches('^[A-Za-z0-9_-]{1,80}$'))
        && k.ay is int && k.ay >= 1 && k.ay <= 12
        && k.yil is int && k.yil >= 2000 && k.yil <= 2199;
    }
    function kartlar(l) {
      let eklenen = l.toSet().difference(resource.data.kartlar.toSet());
      return l is list && l.size() <= 10
        && (eklenen.size() == 0 || (eklenen.size() == 1
          && eklenen.hasOnly([request.resource.data.sonKart]) && kart(request.resource.data.sonKart)));
    }
    function bicim(d) {
      return d.keys().hasOnly(['sahipId', 'ad', 'kod', 'kodAnahtari', 'yildizli', 'surum', 'kartlar', 'sonKart', 'kimlikNo', 'silindi', 'olusturma', 'guncelleme'])
        && metin(d.ad, 2, 80) && metin(d.sahipId, 1, 128)
        && d.kod is string && d.kod.matches('^[A-Za-z0-9_-]{1,24}$')
        && d.kodAnahtari == d.kod.upper() && d.yildizli is bool
        && d.silindi is bool && d.surum is int && d.surum >= 1
        && (d.kimlikNo == '' || d.kimlikNo.matches('^[0-9]{10,11}$'))
        && (d.sonKart == null || kart(d.sonKart))
        && d.olusturma is timestamp && d.guncelleme == request.time
        && d.kartlar is list && d.kartlar.size() <= 10
        && (!d.silindi || d.kartlar.size() == 0);
    }
    function iz(id, surum, eylem) {
      let d = getAfter(/databases/$(database)/documents/denetim/$(id + '_' + string(surum))).data;
      return d.kullaniciId == request.auth.uid && d.cariId == id && d.surum == surum
        && d.eylem == eylem && d.zaman == request.time;
    }
    function kodKaydi(id, d) {
      return d.silindi || getAfter(/databases/$(database)/documents/cariKodlari/$(d.sahipId + '_' + d.kodAnahtari)).data.cariId == id;
    }
    match /kullanicilar/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || yonetici());
      allow list: if yonetici();
      allow create: if yonetici() && request.resource.data.yonetici == false && profilBicim(request.resource.data);
      allow update: if yonetici() && uid != request.auth.uid
        && !resource.data.yonetici && profilBicim(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aktif', 'guncelleme']);
      allow delete: if false;
      function profilBicim(d) {
        return d.keys().hasOnly(['ad', 'eposta', 'yonetici', 'aktif', 'olusturma', 'guncelleme'])
          && metin(d.ad, 2, 80) && metin(d.eposta, 3, 254)
          && d.yonetici is bool && d.aktif is bool
          && d.olusturma is timestamp && d.guncelleme == request.time;
      }
    }
    match /cariler/{id} {
      allow get, list: if erisim(resource.data.sahipId) && (!resource.data.silindi || yonetici());
      allow create: if uye() && bicim(request.resource.data)
        && request.resource.data.sahipId == request.auth.uid && !request.resource.data.silindi
        && request.resource.data.surum == 1 && request.resource.data.olusturma == request.time
        && request.resource.data.kartlar.size() == 0 && request.resource.data.sonKart == null
        && kodKaydi(id, request.resource.data) && iz(id, 1, 'ekle');
      allow update: if erisim(resource.data.sahipId) && !resource.data.silindi
        && bicim(request.resource.data) && request.resource.data.olusturma == resource.data.olusturma
        && request.resource.data.surum == resource.data.surum + 1
        && kartlar(request.resource.data.kartlar)
        && (request.resource.data.sahipId == resource.data.sahipId || (yonetici() && hedefAktif(request.resource.data.sahipId)))
        && kodKaydi(id, request.resource.data)
        && iz(id, request.resource.data.surum, request.resource.data.silindi ? 'sil' : 'kaydet');
      allow delete: if false;
    }
    match /cariKodlari/{key} {
      allow get: if uye() && (!exists(/databases/$(database)/documents/cariKodlari/$(key)) || erisim(resource.data.sahipId));
      allow list: if false;
      allow create: if uye() && request.resource.data.keys().hasOnly(['sahipId', 'kod', 'cariId'])
        && key == request.resource.data.sahipId + '_' + request.resource.data.kod
        && erisim(request.resource.data.sahipId)
        && getAfter(/databases/$(database)/documents/cariler/$(request.resource.data.cariId)).data.sahipId == request.resource.data.sahipId
        && getAfter(/databases/$(database)/documents/cariler/$(request.resource.data.cariId)).data.kodAnahtari == request.resource.data.kod
        && !getAfter(/databases/$(database)/documents/cariler/$(request.resource.data.cariId)).data.silindi;
      allow update: if false;
      allow delete: if erisim(resource.data.sahipId)
        && (getAfter(/databases/$(database)/documents/cariler/$(resource.data.cariId)).data.silindi
          || getAfter(/databases/$(database)/documents/cariler/$(resource.data.cariId)).data.sahipId != resource.data.sahipId
          || getAfter(/databases/$(database)/documents/cariler/$(resource.data.cariId)).data.kodAnahtari != resource.data.kod);
    }
    match /denetim/{id} {
      allow read: if yonetici();
      allow create: if uye() && request.resource.data.keys().hasOnly(['kullaniciId', 'cariId', 'surum', 'eylem', 'zaman'])
        && request.resource.data.kullaniciId == request.auth.uid && request.resource.data.zaman == request.time
        && request.resource.data.eylem in ['ekle', 'kaydet', 'sil']
        && id == request.resource.data.cariId + '_' + string(request.resource.data.surum)
        && getAfter(/databases/$(database)/documents/cariler/$(request.resource.data.cariId)).data.surum == request.resource.data.surum
        && erisim(getAfter(/databases/$(database)/documents/cariler/$(request.resource.data.cariId)).data.sahipId);
      allow update, delete: if false;
    }
    // Tahsilat kayıtları (0.9.0, 0.10.0 eşleşme izi): yalnız eklenir, değiştirilemez/silinemez. Zaman sunucu
    // saatidir; gün Türkiye saatiyle 00:00'da biter, o günün gün sonu kendiliğinden kesinleşir.
    // Cari erişimi ve VKN/TC sunucudaki cari kaydıyla aynı olmalıdır.
    function tahsilatOrtak(d) {
      let c = get(/databases/$(database)/documents/cariler/$(d.cariId)).data;
      return d.kullaniciId == request.auth.uid
        && d.kullaniciAd == get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.ad
        && metin(d.cariId, 1, 128) && metin(d.cariAd, 2, 80)
        && d.kimlikNo is string && d.kimlikNo.matches('^[0-9]{10,11}$')
        && d.kartSonDort is string && d.kartSonDort.matches('^([0-9]{4})?$')
        && d.zaman == request.time
        && erisim(c.sahipId) && !c.silindi && c.kimlikNo == d.kimlikNo;
    }
    match /posGirisleri/{id} {
      allow get, list: if erisim(resource.data.kullaniciId);
      allow create: if uye() && id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['kullaniciId', 'kullaniciAd', 'cariId', 'cariAd', 'kimlikNo', 'kartSonDort', 'zaman'])
        && request.resource.data.keys().size() == 7
        && tahsilatOrtak(request.resource.data);
      allow update, delete: if false;
    }
    match /posIslemleri/{id} {
      // Belge kimliği: başarılıda Pos Sipariş Numarası, başarısızda sonuna "-h" (0.10.1; numara büyük
      // harftir, karışmaz). DenizPay başarısız denemeden sonraki ödemeye aynı numarayı verse de ikisi
      // ayrı yazılır; aynı sonuç ikinci kez yazılmaz. 0.10.1 öncesi başarısız kayıtlar "-h" eksizdir.
      // Olmayan kaydı sorgulamak serbesttir (çift kayıt denetimi için).
      allow get: if uye() && (resource == null || erisim(resource.data.kullaniciId));
      allow list: if erisim(resource.data.kullaniciId);
      allow create: if uye() && id.matches('^[A-Z0-9_-]{4,64}(-h)?$')
        && request.resource.data.keys().hasOnly(['kullaniciId', 'kullaniciAd', 'cariId', 'cariAd', 'kimlikNo', 'kartSonDort',
          'girisId', 'sonuc', 'aciklama', 'posSiparisNo', 'uyeSiparisNo', 'tutarMetni', 'tutarKurus', 'kaynak',
          'eslesme', 'okunma', 'zaman'])
        && request.resource.data.keys().size() == 17
        && islemBicim(id, request.resource.data) && tahsilatOrtak(request.resource.data);
      allow update, delete: if false;
      // eslesme: cari nasıl belirlendi (denetim izi; lib/domain/tahsilat.dart CariEslesmesi).
      // 'son_giris': 0.9.0 sonuç sayfasının telefonda bekleyen sonucu (yeni sayfa yazmaz). okunma: sonucun
      // telefonda okunduğu an (yalnız bilgi; gün ve sıra sunucu saatidir). Elle kayıtta yok.
      // Telefon saati kayık olabilir: 1 günden ileri veya 31 günden eski olamaz.
      function islemBicim(id, d) {
        return d.posSiparisNo is string && d.posSiparisNo.matches('^[A-Z0-9_-]{4,64}$')
          && ((d.sonuc == 'basarili' && id == d.posSiparisNo) || (d.sonuc == 'hata' && id == d.posSiparisNo + '-h'))
          && d.kaynak in ['yer_imi', 'elle', 'uygulama']
          && ((d.kaynak == 'elle' && d.eslesme == 'elle' && d.okunma == null)
            || (((d.kaynak == 'yer_imi' && d.eslesme in ['sonuc_ekrani', 'kart_sayfasi', 'tek_giris', 'secim', 'son_giris'])
                // Android (27 Ekim 2026): uygulama içi DenizPay oturumunun sonuç ekranı; cari o oturumdan kesin.
                || (d.kaynak == 'uygulama' && d.eslesme == 'uygulama_ici'))
              && d.okunma is timestamp && d.okunma <= request.time + duration.value(1, 'd')
              && d.okunma > request.time - duration.value(31, 'd')))
          && metin(d.aciklama, 1, 200) && metin(d.tutarMetni, 1, 40)
          && (d.uyeSiparisNo == '' || metin(d.uyeSiparisNo, 1, 40))
          && d.girisId is string && d.girisId.matches('^([A-Za-z0-9]{20})?$')
          && (d.tutarKurus == null || (d.tutarKurus is int && d.tutarKurus >= 0 && d.tutarKurus <= 99999999999));
      }
    }
    // ---------------------------------------------------------------------------------------------
    // Rota (plasiyer konum takibi) — sözleşme ve gerekçe: docs/ROTA_MIMARI.md §4 (şema sürümü 1).
    // Terminal: Kotlin'deki ayrı "rota" uygulamasının anonim oturumu (M2); yalnız onaylı (rotaCihazlar
    // belgesi olan ve aktif) terminal yazar, yalnız ekler. Merkez: Google girişli ve rotaYetkileri'nde
    // kaydı olan hesap (M4). Sanal POS'un parolalı hesapları (terminaldeki oturum dahil) rota verisine
    // hiç erişemez. Merkezin her değişikliği aynı toplu yazmadaki taze bir rotaDenetim kaydına bağlıdır.
    function rotaGoogle() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function rotaYetkiYolu() { return /databases/$(database)/documents/rotaYetkileri/$(request.auth.token.email); }
    function rotaRol(roller) {
      return rotaGoogle() && exists(rotaYetkiYolu()) && get(rotaYetkiYolu()).data.aktif == true
        && get(rotaYetkiYolu()).data.rol in roller;
    }
    function rotaIzleyici() { return rotaRol(['yonetici', 'izleyici']); }
    function rotaYoneticisi() { return rotaRol(['yonetici']); }
    function rotaTerminal() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function rotaCihazYolu(uid) { return /databases/$(database)/documents/rotaCihazlar/$(uid); }
    function rotaOnayli() {
      return rotaTerminal() && exists(rotaCihazYolu(request.auth.uid)) && get(rotaCihazYolu(request.auth.uid)).data.aktif == true;
    }
    function rotaIz(hedef) {
      let d = request.resource.data;
      return d.denetim is string && d.denetim.matches('^[A-Za-z0-9]{20}$')
        && getAfter(/databases/$(database)/documents/rotaDenetim/$(d.denetim)).data.yazan == request.auth.uid
        && getAfter(/databases/$(database)/documents/rotaDenetim/$(d.denetim)).data.hedef == hedef
        && getAfter(/databases/$(database)/documents/rotaDenetim/$(d.denetim)).data.zaman == request.time;
    }
    function rotaDamga(d) { return d.guncelleme == request.time && d.guncelleyen == request.auth.uid; }
    function rotaSayi(x, en, ust) { return x is int && x >= en && x <= ust; }
    function rotaOlcu(x, en, ust) { return (x is int || x is float) && x >= en && x <= ust; }

    match /rotaYetkileri/{eposta} {
      // Belge kimliği küçük harfli e-postadır (Google jetonundaki e-posta ile birebir).
      allow get: if (rotaGoogle() && request.auth.token.email == eposta) || rotaYoneticisi();
      allow list: if rotaYoneticisi();
      // Yönetici rolü yalnız yönetici aracıyla (admin SDK) verilir; kimse kendi kaydını değiştiremez.
      allow create, update: if rotaYoneticisi() && eposta != request.auth.token.email
        && eposta.matches('^[a-z0-9._%+-]{1,64}@[a-z0-9.-]{1,190}$')
        && (resource == null || resource.data.rol == 'izleyici')
        && request.resource.data.keys().hasOnly(['ad', 'rol', 'aktif', 'guncelleme', 'guncelleyen', 'denetim'])
        && request.resource.data.keys().size() == 6
        && metin(request.resource.data.ad, 2, 60) && request.resource.data.rol == 'izleyici'
        && request.resource.data.aktif is bool && rotaDamga(request.resource.data)
        && rotaIz('rotaYetkileri/' + eposta);
      allow delete: if false;
    }
    match /rotaDenetim/{id} {
      allow get, list: if rotaYoneticisi();
      allow create: if rotaYoneticisi() && id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['yazan', 'eylem', 'hedef', 'zaman'])
        && request.resource.data.keys().size() == 4
        && request.resource.data.yazan == request.auth.uid && request.resource.data.zaman == request.time
        && request.resource.data.eylem is string && request.resource.data.eylem.matches('^[a-z_]{3,30}$')
        && metin(request.resource.data.hedef, 3, 200);
      allow update, delete: if false;
    }
    match /rotaBasvurular/{uid} {
      // Terminal kendi başvurusunun var olup olmadığına bakabilir (yoksa resource null'dır).
      allow get: if (rotaTerminal() && request.auth.uid == uid) || rotaYoneticisi();
      allow list: if rotaYoneticisi();
      allow create: if rotaTerminal() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['s', 'kod', 'model', 'uretici', 'android', 'surum', 'olusturma'])
        && request.resource.data.keys().size() == 7
        && request.resource.data.s == 1 && request.resource.data.kod is string
        && request.resource.data.kod.matches('^[A-HJ-NP-Z2-9]{6}$')
        && metin(request.resource.data.model, 1, 60) && metin(request.resource.data.uretici, 1, 60)
        && rotaSayi(request.resource.data.android, 21, 99) && rotaSayi(request.resource.data.surum, 1, 99999999)
        && request.resource.data.olusturma == request.time;
      allow update: if false;
      // Onaylanmamış (gereksiz) başvuru silinebilir; onaylanmışın izi kalır.
      allow delete: if rotaYoneticisi() && !exists(rotaCihazYolu(uid));
    }
    match /rotaCihazlar/{uid} {
      allow get: if (rotaTerminal() && request.auth.uid == uid) || rotaIzleyici();
      allow list: if rotaIzleyici();
      allow create: if rotaYoneticisi() && exists(/databases/$(database)/documents/rotaBasvurular/$(uid))
        && rotaCihazBicim(request.resource.data) && request.resource.data.olusturma == request.time
        && rotaIz('rotaCihazlar/' + uid);
      allow update: if rotaYoneticisi() && rotaCihazBicim(request.resource.data)
        && request.resource.data.olusturma == resource.data.olusturma && rotaIz('rotaCihazlar/' + uid);
      // Onay kaldırma silme değil "aktif: false"dır (geçmiş parçalar bu terminale bağlı kalır).
      allow delete: if false;
      function rotaCihazBicim(d) {
        return d.keys().hasOnly(['ad', 'aktif', 'takip', 'hareketSn', 'durgunSn', 'depoSn', 'olusturma', 'guncelleme', 'guncelleyen', 'denetim'])
          && d.keys().size() == 10
          && metin(d.ad, 1, 40) && d.aktif is bool && d.takip is bool
          && rotaSayi(d.hareketSn, 5, 3600) && rotaSayi(d.durgunSn, 5, 3600) && rotaSayi(d.depoSn, 5, 3600)
          && d.olusturma is timestamp && rotaDamga(d);
      }
    }
    match /rotaSonDurum/{uid} {
      allow get, list: if rotaIzleyici();
      // Hız sınırı: aynı terminal en çok 15 sn'de bir günceller (kota koruması). Parça yazımı da
      // bu güncellemeye bağlı olduğu için parçalar da bu hızla sınırlıdır.
      allow create: if rotaOnayli() && request.auth.uid == uid && rotaDurumBicim(request.resource.data);
      allow update: if rotaOnayli() && request.auth.uid == uid && rotaDurumBicim(request.resource.data)
        && request.time >= resource.data.guncelleme + duration.value(15, 's');
      allow delete: if false;
      function rotaDurumBicim(d) {
        return d.keys().hasOnly(['s', 'z', 'en', 'boy', 'dog', 'hiz', 'yon', 'pil', 'sarj', 'durum', 'bekleyen', 'surum', 'guncelleme'])
          && d.keys().size() == 13 && d.s == 1
          && (d.z == null || rotaSayi(d.z, 1500000000000, 9999999999999))
          && (d.en == null || rotaOlcu(d.en, -90, 90)) && (d.boy == null || rotaOlcu(d.boy, -180, 180))
          && (d.dog == null || rotaOlcu(d.dog, 0, 100000))
          && (d.hiz == null || rotaOlcu(d.hiz, 0, 200)) && (d.yon == null || rotaOlcu(d.yon, 0, 360))
          && rotaSayi(d.pil, 0, 100) && d.sarj is bool
          && d.durum in ['hareket', 'durgun', 'depoda', 'kapali', 'izin_yok', 'konum_kapali', 'onay_bekliyor']
          && rotaSayi(d.bekleyen, 0, 10000000) && rotaSayi(d.surum, 1, 99999999)
          && d.guncelleme == request.time;
      }
    }
    match /rotaParcalar/{id} {
      // Terminal yalnız kendi parçasının var olup olmadığına bakabilir (M6: belirsiz gönderimden sonra).
      allow get: if (rotaTerminal() && id.matches('^[A-Za-z0-9]{1,128}_[0-9]{1,15}$')
          && id.split('_')[0] == request.auth.uid) || rotaIzleyici();
      allow list: if rotaIzleyici();
      allow create: if rotaOnayli() && rotaParcaBicim(id, request.resource.data)
        && getAfter(/databases/$(database)/documents/rotaSonDurum/$(request.auth.uid)).data.guncelleme == request.time;
      allow update: if false;
      // Saklama 90 gün (K14); TTL çalışmazsa yönetici temizliği (M15).
      allow delete: if rotaYoneticisi() && resource.data.alindi < request.time - duration.value(90, 'd');
      function rotaParcaBicim(id, d) {
        return d.keys().hasOnly(['s', 'cihaz', 'ilk', 'son', 'bas', 'bit', 'alindi', 'silinme', 'cihazSaati', 'pil', 'sarj', 'surum', 'n', 'olaylar'])
          && d.keys().size() == 14 && d.s == 1 && d.cihaz == request.auth.uid
          && rotaSayi(d.ilk, 1, 999999999999999) && d.son is int && d.son >= d.ilk
          && id == request.auth.uid + '_' + string(d.ilk)
          && d.n is list && d.n.size() <= 240 && d.olaylar is list && d.olaylar.size() <= 50
          // Noktalar ve olaylar aynı sıra numarasını paylaşır: parça içinde boşluk olamaz,
          // parçalar arası boşluk okuyan tarafta kayıp olarak görülür.
          && d.son - d.ilk + 1 == d.n.size() + d.olaylar.size()
          && d.bas is timestamp && d.bit is timestamp && d.bas <= d.bit
          && d.bit <= request.time + duration.value(10, 'm') && d.bas >= request.time - duration.value(30, 'd')
          && d.alindi == request.time && d.silinme == d.bit + duration.value(90, 'd')
          && rotaSayi(d.cihazSaati, 1500000000000, 9999999999999)
          && rotaSayi(d.pil, 0, 100) && d.sarj is bool && rotaSayi(d.surum, 1, 99999999);
      }
    }
    match /rotaAraclar/{aracId} {
      allow get, list: if rotaIzleyici();
      allow create, update: if rotaYoneticisi() && aracId.matches('^[A-Za-z0-9_-]{1,40}$')
        && request.resource.data.keys().hasOnly(['no', 'plasiyer', 'renk', 'yakit', 'tuketim', 'aktif', 'guncelleme', 'guncelleyen', 'denetim'])
        && request.resource.data.keys().size() == 9
        && metin(request.resource.data.no, 1, 20) && metin(request.resource.data.plasiyer, 2, 60)
        && request.resource.data.renk is string && request.resource.data.renk.matches('^#[0-9a-f]{6}$')
        && request.resource.data.yakit in ['dizel', 'benzin', 'lpg', 'elektrik', 'bilinmiyor']
        && (request.resource.data.tuketim == null || rotaOlcu(request.resource.data.tuketim, 1, 60))
        && request.resource.data.aktif is bool && rotaDamga(request.resource.data)
        && rotaIz('rotaAraclar/' + aracId);
      allow delete: if false;
    }
    match /rotaAtamalar/{id} {
      // Yalnız eklenir: yanlış atama, daha geç yazılmış bir düzeltme atamasıyla geçersiz kılınır.
      allow get, list: if rotaIzleyici();
      allow create: if rotaYoneticisi() && id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['cihaz', 'arac', 'bas', 'yazan', 'zaman'])
        && request.resource.data.keys().size() == 5
        && request.resource.data.cihaz is string && existsAfter(rotaCihazYolu(request.resource.data.cihaz))
        && request.resource.data.arac is string
        && existsAfter(/databases/$(database)/documents/rotaAraclar/$(request.resource.data.arac))
        && request.resource.data.bas is timestamp && request.resource.data.bas <= request.time + duration.value(30, 'd')
        && request.resource.data.yazan == request.auth.uid && request.resource.data.zaman == request.time;
      allow update, delete: if false;
    }
    match /rotaAyar/{ad} {
      allow get: if ad == 'genel' && (rotaOnayli() || rotaIzleyici());
      allow create, update: if ad == 'genel' && rotaYoneticisi()
        && request.resource.data.keys().hasOnly(['depolar', 'bolgeler', 'guncelleme', 'guncelleyen', 'denetim'])
        && request.resource.data.keys().size() == 5
        && request.resource.data.depolar is list && request.resource.data.depolar.size() <= 10
        && request.resource.data.bolgeler is list && request.resource.data.bolgeler.size() <= 10
        && rotaDamga(request.resource.data) && rotaIz('rotaAyar/' + ad);
      allow delete: if false;
    }
    // ---------------------------------------------------------------------------------------------
    // Android sürüm denetimi (lib/domain/surum.dart): üyeler okur; yalnız yönetici
    // aracı (admin SDK, tools/android_yayin.sh) yazar.
    match /ayarlar/android { allow get: if uye(); }
    match /{document=**} { allow read, write: if false; }
  }
}
